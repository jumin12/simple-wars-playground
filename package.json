{
  "name": "simple-wars",
  "private": true,
  "description": "Shim so Render can build the relay from repo root. Prefer setting Web Service Root Directory to server/.",
  "scripts": {
    "postinstall": "npm install --prefix server",
    "start": "node server/index.js",
    "missions:sync": "node scripts/sync-missions-manifest.js",
    "missions:store": "node scripts/generate-store-missions.js && node scripts/sync-store-catalog.js",
    "store:sync": "node scripts/sync-store-catalog.js",
    "store:check": "node scripts/sync-store-catalog.js --check",
    "store:test": "node scripts/verify-steam-commerce.js",
    "music:credits": "node scripts/sync-music-credits.js",
    "music:credits:check": "node scripts/sync-music-credits.js --check",
    "security:check": "node scripts/verify-no-secrets.js",
    "security:release": "node scripts/verify-no-secrets.js --steam",
    "security:test": "node scripts/verify-no-secrets.test.js"
  }
}
